# ============================================================
# tome-app — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ---- Server ----
NODE_ENV=development
PORT=3001

# Allowed CORS origin (frontend URL).
# PRODUCTION: set to your HTTPS domain, e.g. https://tome.example.com
# Cookies with Secure flag will not be sent over HTTP — HTTPS is required in prod.
ALLOWED_ORIGIN=https://localhost
# Direct dev (Vite): ALLOWED_ORIGIN=http://localhost:5173

# Optional: set to debug/warn/error to control pino log verbosity (default: info)
LOG_LEVEL=info

# ---- Database ----
# PostgreSQL connection URL
DATABASE_URL=postgres://tome_app:yourpassword@postgres:5432/tome_app
# PostgreSQL superuser password (used by the postgres Docker service)
POSTGRES_PASSWORD=yourpassword

# ---- Authentication ----
# JWT secret — used to sign session cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# REQUIRED in production.
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48

# JWT session expiry (parsed by jsonwebtoken — e.g. 7d, 24h, 30d).
# Defaults to 7d if unset.
JWT_EXPIRY=7d

# ---- Frontend (Vite build-time vars must be prefixed VITE_) ----
# Leave empty in production — Nginx serves the app and proxies /api on the same origin.
VITE_API_BASE_URL=

# ---- Admin UI ----
# Set this to enable the admin UI on port 3002 (loopback only — never exposed publicly).
# Access via SSH tunnel: ssh -L 3002:localhost:3002 user@your-server
# Then open: http://localhost:3002/admin/
# Leave empty to disable the admin server entirely.
ADMIN_SECRET=

# Separate signing key for admin session tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# REQUIRED when ADMIN_SECRET is set.
ADMIN_TOKEN_SIGNING_KEY=

# ---- Manuscript PII Encryption ----
# AES-256-GCM key for encrypting ms_legal_name, ms_pen_name, ms_address, ms_phone, ms_email.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Leave empty in dev (graceful degradation — fields stored/returned as plaintext).
# REQUIRED in production.
MANUSCRIPT_ENCRYPTION_KEY=

# ---- Backup Encryption ----
# GPG symmetric passphrase for encrypting database backup files (.sql.gpg).
# If empty, backups are written as plain .sql files.
# Generate: openssl rand -base64 32
# RECOMMENDED in production.
BACKUP_PASSPHRASE=
