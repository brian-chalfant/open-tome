# ── E2E Environment Variables ─────────────────────────────────────────────────
# Copy this file to e2e/.env.e2e and fill in the values.
# NEVER commit .env.e2e — it contains test credentials.
#
# SETUP STEPS:
#   1. Start the Docker stack: docker compose up -d
#   2. Create a test user account via the signup page or API
#   3. Fill in the credentials below
#   4. cd e2e && npm install && npx playwright install chromium
#   5. npm test
# ──────────────────────────────────────────────────────────────────────────────

# ── Test user credentials (REQUIRED) ─────────────────────────────────────────

E2E_TEST_EMAIL=test@example.com
E2E_TEST_PASSWORD=your-test-password

# ── URLs (optional — defaults shown) ─────────────────────────────────────────

# Frontend base URL (Playwright uses this as baseURL for all page.goto() calls).
# E2E_BASE_URL=http://localhost:5173

# Backend URL used for the health-check poll and the direct API test.
# E2E_API_URL=http://localhost:3001
