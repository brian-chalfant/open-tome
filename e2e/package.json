{
  "name": "open-tome-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "Playwright E2E tests for Open Tome",
  "scripts": {
    "test":        "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug":  "playwright test --debug",
    "test:ui":     "playwright test --ui",
    "report":      "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node":      "22.15.3",
    "dotenv":           "17.4.2",
    "typescript":       "5.8.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
