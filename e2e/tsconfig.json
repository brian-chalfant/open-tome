{
  "compilerOptions": {
    "target":            "ES2022",
    "module":            "CommonJS",
    "lib":               ["ES2022"],
    "strict":            true,
    "esModuleInterop":   true,
    "resolveJsonModule": true,
    "moduleResolution":  "node",
    "baseUrl":           ".",
    "skipLibCheck":      true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist", "playwright-report", "test-results"]
}
